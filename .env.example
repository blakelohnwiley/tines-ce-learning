# Copy to .env and fill in after Tines CE signup.
# Never commit .env to git.

# Your tenant base URL (e.g. https://my-company.tines.com)
TENANT_URL=

# --- Active stories ---
WEBHOOK_URL=
WEBHOOK_URL_ADVANCED=

