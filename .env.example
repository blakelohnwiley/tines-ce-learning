# Copy to .env and fill in after Tines CE signup.
# Never commit .env to git.

# Your tenant base URL (e.g. https://my-company.tines.com)
TENANT_URL=

# Full webhook URL from your Webhook action (includes path and secret)
# Example: https://my-company.tines.com/webhook/abc123/def456
WEBHOOK_URL=

# Alert Triage Advanced story (duplicate + extended workflow)
WEBHOOK_URL_ADVANCED=

# Optional webhook URLs for exported-only workflows (enable story first, copy from Webhook action)
# Format: https://<tenant>.tines.com/webhook/<path>/<secret>
# WEBHOOK_URL_IP_ENRICHMENT=
# WEBHOOK_URL_URL_REPUTATION=
# WEBHOOK_URL_DEDUP_ALERTS=
# WEBHOOK_URL_THROTTLE_DEMO=
# WEBHOOK_URL_DELAY_RETRY=
# WEBHOOK_URL_GEO_BLOCK=

# Optional: default JSON payload file for send-test-webhook.sh
# PAYLOAD_FILE=scripts/sample-payload.json
