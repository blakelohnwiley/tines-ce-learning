<mxfile host="app.diagrams.net">
  <diagram name="CE Flow Strategy" id="ce-flow-strategy">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tenant-group" value="Tenant (max 3 active flows)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;startSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="live-a" value="Live A&#xa;alert-triage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="tenant-group">
          <mxGeometry x="30" y="50" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="live-b" value="Live B&#xa;alert-triage-advanced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=12;" vertex="1" parent="tenant-group">
          <mxGeometry x="155" y="50" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="live-c" value="Live C&#xa;(free slot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;dashed=1;" vertex="1" parent="tenant-group">
          <mxGeometry x="280" y="50" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="local-group" value="Local exports/workflows (unlimited JSON)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;startSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="420" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="library" value="JSON library&#xa;9 workflows + catalog.yaml" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=12;" vertex="1" parent="local-group">
          <mxGeometry x="130" y="40" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge-import" value="import + enable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;html=1;fontStyle=1;" edge="1" parent="1" source="library" target="live-c">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-export" value="export + disable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;html=1;fontStyle=1;" edge="1" parent="1" source="live-a" target="library">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="170"/>
              <mxPoint x="560" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
